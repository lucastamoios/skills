{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ask.input.schema.json",
  "title": "marketing:ask input",
  "type": "object",
  "properties": {
    "contract": {
      "const": "marketing/v1"
    },
    "skill": {
      "const": "ask"
    },
    "language": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "creator": {
          "$ref": "common.schema.json#/$defs/creator"
        },
        "product": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "goal": {
          "type": "string",
          "description": "What the next video should achieve, if known."
        },
        "topic": {
          "type": "string",
          "description": "Optional topic to steer the questions."
        },
        "previous_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question"
            ],
            "additionalProperties": false
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "conversation": {
          "type": "array",
          "description": "The turns of the current case so far, verbatim and in order: each question asked and the creator's answer. Empty or absent on the first call.",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "used_topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Topics and cases already used in earlier scripts, so the interview does not return to them."
        }
      },
      "required": [
        "creator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "skill",
    "input"
  ],
  "additionalProperties": false
}
