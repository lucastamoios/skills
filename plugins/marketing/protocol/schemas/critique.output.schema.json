{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critique.output.schema.json",
  "title": "marketing:critique output",
  "type": "object",
  "properties": {
    "contract": {
      "const": "marketing/v1"
    },
    "skill": {
      "const": "critique"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_input",
        "blocked"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "approve",
            "revise",
            "rethink"
          ]
        },
        "summary": {
          "type": "string",
          "description": "Two sentences the expert would say."
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string"
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "criterion_id",
              "score",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "beat_id": {
                "type": "string"
              },
              "criterion_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "major",
                  "minor"
                ]
              },
              "problem": {
                "type": "string"
              },
              "fix": {
                "type": "string",
                "description": "Concrete rewrite instruction or replacement line."
              }
            },
            "required": [
              "id",
              "criterion_id",
              "severity",
              "problem",
              "fix"
            ],
            "additionalProperties": false
          }
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What works and must survive the revision."
        },
        "rewrite_brief": {
          "type": "string",
          "description": "Instructions for marketing:script in revise mode."
        },
        "rethink_reason": {
          "type": "string",
          "description": "When verdict is rethink: which upstream step must change (ask, angle, material, reference)."
        }
      },
      "required": [
        "verdict",
        "summary",
        "scores",
        "issues",
        "keep",
        "rewrite_brief"
      ],
      "additionalProperties": false
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/missing_input"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contract",
    "skill",
    "status",
    "result",
    "missing_inputs",
    "warnings"
  ],
  "additionalProperties": false
}
