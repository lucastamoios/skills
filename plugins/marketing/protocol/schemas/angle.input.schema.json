{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "angle.input.schema.json",
  "title": "marketing:angle input",
  "type": "object",
  "properties": {
    "contract": {
      "const": "marketing/v1"
    },
    "skill": {
      "const": "angle"
    },
    "language": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "creator": {
          "$ref": "common.schema.json#/$defs/creator"
        },
        "product": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "material": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/material"
          },
          "description": "The case or answer the video is built from."
        },
        "reference_analysis": {
          "type": "object",
          "description": "Optional: result of marketing:reference."
        },
        "expert_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "creator",
        "material"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "skill",
    "input"
  ],
  "additionalProperties": false
}